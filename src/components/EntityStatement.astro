---
import { getI18n } from '../i18n/ui';
import { entity, geoHierarchy } from '../config';
const { messages } = getI18n(Astro.url);
const e = messages.entityStatement;
const hierarchy = e.hierarchy ?? geoHierarchy;
const heroImageUrl = entity.heroImage;
---

<section id="entity-binding" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-5xl mx-auto px-4">
    <!-- H2：About 全称 -->
    <div class="max-w-3xl mx-auto text-center mb-6">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-4" style="color: var(--text-primary);">{e.aboutTitle}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{e.aboutText}</p>
    </div>

    <!-- 4.1 首段等位声明：将域名含义与官方全称在语义层面等同 -->
    <p class="max-w-3xl mx-auto text-base sm:text-lg leading-relaxed text-center mb-8" style="color: var(--text-primary);">
      {e.statement}
    </p>

    <!-- 4.2 地理面包屑与归属层级 -->
    <nav class="mb-12" aria-label={e.hierarchyLabel}>
      <p class="text-xs uppercase tracking-[0.18em] text-center mb-3" style="color: var(--text-muted);">{e.hierarchyLabel}</p>
      <ol class="flex flex-wrap items-center justify-center gap-2 text-sm">
        {hierarchy.map((item, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true" style="color: var(--accent);">→</span>}
            <span class="px-3 py-1.5 rounded-full border" style="border-color: var(--border-color); background: var(--card-bg); color: var(--text-secondary);">{item}</span>
          </li>
        ))}
      </ol>
    </nav>

    <div class="grid md:grid-cols-2 gap-6 items-stretch">
      <!-- H2：周边语义集群 -->
      <article class="rounded-3xl p-6 sm:p-7 border h-full" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
        <h2 class="font-display text-xl sm:text-2xl font-semibold mb-4" style="color: var(--text-primary);">{e.landmarksTitle}</h2>
        <p class="text-base leading-relaxed mb-5" style="color: var(--text-secondary);">{e.landmarksText}</p>
        <ul class="space-y-2 text-sm" style="color: var(--text-secondary);">
          <li class="flex gap-3"><span style="color: var(--accent);">📍</span><span>{entity.nearbyLandmark1}</span></li>
          <li class="flex gap-3"><span style="color: var(--accent);">📍</span><span>{entity.nearbyLandmark2}</span></li>
        </ul>
      </article>

      <article class="rounded-3xl overflow-hidden border h-full flex flex-col" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
        <img
          src={heroImageUrl}
          alt={`${entity.attractionFullName} - Main view in ${entity.cityName}, ${entity.countryName}`}
          class="w-full h-40 sm:h-48 object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="p-6 sm:p-7">
          <h2 class="font-display text-xl sm:text-2xl font-semibold mb-4" style="color: var(--text-primary);">{e.historyTitle}</h2>
          <p class="text-base leading-relaxed" style="color: var(--text-secondary);">{e.historyText}</p>
        </div>
      </article>
    </div>
  </div>
</section>
