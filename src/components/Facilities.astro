---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const f = messages.facilities;
---

<section id="facilities" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">
      {f.title}
    </h2>
    <p class="text-center text-base max-w-3xl mx-auto mb-4" style="color: var(--text-secondary);">{f.subtitle}</p>
    <p class="text-center text-sm max-w-2xl mx-auto mb-10 neutral-note">{f.neutralNote}</p>

    <h3 class="font-display text-2xl font-semibold mb-6" style="color: var(--text-primary);">{f.itemsTitle}</h3>

    <div class="grid md:grid-cols-2 gap-5">
      {f.items.map((item) => (
        <article class="rounded-2xl p-5 sm:p-6 border flex gap-4" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <span class="text-2xl leading-none shrink-0" aria-hidden="true">{item.icon}</span>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <h4 class="font-semibold text-base" style="color: var(--text-primary);">{item.name}</h4>
              <span class="facility-badge">{item.availability}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.detail}</p>
            <p class="text-sm leading-relaxed mt-2" style="color: var(--text-muted);">💡 {item.tip}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="text-xs mt-8" style="color: var(--text-muted);">{f.note}</p>
  </div>
</section>
