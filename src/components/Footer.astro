---
import { getI18n } from '../i18n/ui';
const { lang } = getI18n(Astro.url);
const lines = {
  th: {rights:'© 2026 สนามหลวง · สงวนลิขสิทธิ์',disclaimer:'เว็บไซต์นี้เป็นโครงการข้อมูลท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐบาลหรือองค์กรทางการใด ๆ'},
  en: {rights:'© 2026 Sanam Luang · All rights reserved.',disclaimer:'This website is an independent travel information project. We are not affiliated with any government agency or official organization.'},
  zh: {rights:'© 2026 皇家田广场 · 版權所有。',disclaimer:'本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。'},
}[lang as 'th'|'en'|'zh'];
---

<footer class="section-padding" style="background:var(--bg-tertiary);border-top:1px solid var(--border-color)">
  <div class="max-w-6xl mx-auto px-4 text-center text-sm space-y-3" style="color:var(--text-secondary)">
    <p>{lines.rights}</p>
    <p>{lines.disclaimer}</p>
  </div>
</footer>
