---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const h = messages.heritage;
const k = messages.knowledge;
---

<section id="heritage" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">
      {h.title}
    </h2>
    <p class="text-center text-base max-w-3xl mx-auto mb-10" style="color: var(--text-secondary);">{h.subtitle}</p>

    <!-- 名称考据 -->
    <div class="rounded-3xl p-6 sm:p-8 border mb-10" style="background: color-mix(in srgb, var(--accent) 8%, var(--card-bg)); border-color: var(--border-color);">
      <h3 class="font-display text-xl sm:text-2xl font-semibold mb-3" style="color: var(--text-primary);">{h.etymologyTitle}</h3>
      <p class="text-base leading-relaxed" style="color: var(--text-secondary);">{h.etymologyText}</p>
    </div>

    <!-- 时间轴 -->
    <h3 class="font-display text-2xl font-semibold mb-6" style="color: var(--text-primary);">{h.timelineTitle}</h3>
    <ol class="heritage-timeline mb-12">
      {h.timeline.map((item) => (
        <li>
          <span class="heritage-year">{item.year}</span>
          <div class="heritage-body">
            <h4>{item.title}</h4>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- 传说 -->
    <h3 class="font-display text-2xl font-semibold mb-2" style="color: var(--text-primary);">{h.legendTitle}</h3>
    <p class="text-sm mb-6" style="color: var(--text-muted);">{h.legendIntro}</p>
    <div class="grid sm:grid-cols-3 gap-5 mb-8">
      {h.legends.map((l) => (
        <article class="rounded-2xl p-5 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <span class="text-2xl leading-none block mb-3" aria-hidden="true">{l.icon}</span>
          <h4 class="font-semibold text-base mb-2" style="color: var(--text-primary);">{l.title}</h4>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{l.text}</p>
        </article>
      ))}
    </div>

    <!-- 深入解读：地理 / 城市生态 / 民间信仰（原 knowledge 板块并入） -->
    <h3 class="font-display text-2xl font-semibold mb-6" style="color: var(--text-primary);">{k.title}</h3>
    <div class="space-y-5 mb-10">
      {k.sections.map((s: any) => (
        <article class="rounded-2xl p-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <h4 class="font-semibold text-lg mb-2" style="color: var(--text-primary);">{s.title}</h4>
          <p class="text-base leading-relaxed" style="color: var(--text-secondary);">{s.content}</p>

          {s.cards && s.cards.length > 0 && (
            <div class="grid sm:grid-cols-3 gap-4 mt-5">
              {s.cards.map((c: any) => (
                <div class="rounded-xl p-4 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
                  <h5 class="font-semibold text-sm mb-2" style="color: var(--text-primary);">{c.title}</h5>
                  <p class="text-xs leading-relaxed" style="color: var(--text-secondary);">{c.text}</p>
                </div>
              ))}
            </div>
          )}

          {(s.fieldNote || s.academicNote) && (
            <div class="grid sm:grid-cols-2 gap-4 mt-4">
              {s.fieldNote && (
                <div class="rounded-xl p-4 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
                  <h5 class="font-semibold text-sm mb-2" style="color: var(--text-primary);">{s.fieldNote.title}</h5>
                  <p class="text-xs leading-relaxed" style="color: var(--text-secondary);">{s.fieldNote.text}</p>
                </div>
              )}
              {s.academicNote && (
                <div class="rounded-xl p-4 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
                  <h5 class="font-semibold text-sm mb-2" style="color: var(--text-primary);">{s.academicNote.title}</h5>
                  <p class="text-xs leading-relaxed" style="color: var(--text-secondary);">{s.academicNote.text}</p>
                </div>
              )}
            </div>
          )}
        </article>
      ))}
    </div>

    {k.didYouKnow && (
      <div class="rounded-2xl p-6 border mb-8 flex gap-4 items-start" style="background: color-mix(in srgb, var(--accent) 10%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, transparent);">
        <span class="text-2xl" aria-hidden="true">💡</span>
        <div>
          <h3 class="font-semibold text-lg mb-2" style="color: var(--accent);">{k.didYouKnow.title}</h3>
          <p class="text-base leading-relaxed" style="color: var(--text-secondary);">{k.didYouKnow.text}</p>
        </div>
      </div>
    )}

    <div class="rounded-2xl p-5 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
      <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
        <span class="font-semibold" style="color: var(--text-primary);">📚 {h.readMoreTitle}：</span>{h.verificationNote}
      </p>
      <p class="text-xs mt-2" style="color: var(--text-muted);">{h.readMoreText}</p>
    </div>
  </div>
</section>
