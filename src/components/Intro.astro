---
import { getI18n } from '../i18n/ui';
import { entity } from '../config';
const { messages } = getI18n(Astro.url);
const intro = messages.intro;
const om = messages.officialManagement;
const community = messages.nonprofitBanner;
const mission = messages.footer.mission;
const f = messages.footer;
const s = messages.sources;
const independentTitle = {
  th: 'เกี่ยวกับคู่มืออิสระ',
  en: 'About this independent guide',
  zh: '关于本独立指南',
}[getI18n(Astro.url).lang];
---

<section id="about" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-12 items-start">
      <div>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-5" style="color: var(--text-primary);">{intro.title}</h2>
        <p class="text-lg leading-relaxed mb-8" style="color: var(--text-secondary);">{intro.description}</p>

        <div class="rounded-2xl p-6 border mb-6" style="background:var(--card-bg);border-color:var(--border-color)">
          <h3 class="font-semibold mb-3" style="color:var(--text-primary)">🧭 {independentTitle}</h3>
          <p class="text-base leading-relaxed mb-3" style="color:var(--text-secondary)">{community.text}</p>
          <h3 class="font-semibold mb-3 mt-5" style="color:var(--text-primary)">{mission.title}</h3>
          <p class="text-base leading-relaxed" style="color:var(--text-secondary)">{mission.text}</p>
        </div>

        {om.title && (
          <div class="rounded-2xl p-6 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
            <h3 class="font-semibold mb-3" style="color: var(--text-primary);">{om.title}</h3>
            <p class="text-base leading-relaxed" style="color: var(--text-secondary);">{om.text}</p>
          </div>
        )}
        <div class="rounded-2xl p-6 border mt-6" style="background:var(--card-bg);border-color:var(--border-color)">
          <h3 class="font-semibold mb-2" style="color:var(--text-primary)">{s.authorityTitle}</h3>
          <p class="text-sm leading-relaxed mb-3" style="color:var(--text-secondary)">{s.authorityText}</p>
          <ul class="grid sm:grid-cols-2 gap-2 text-sm">
            <li><a class="underline" style="color:var(--accent)" href={entity.govtTourismUrl} target="_blank" rel="noopener noreferrer">{entity.countryName} / {entity.cityName} Official Tourism Portal ↗</a></li>
            {(f.officialLinksList ?? []).map(link => <li><a class="underline" style="color:var(--accent)" href={link.url} target="_blank" rel="noopener noreferrer">{link.name} ↗</a></li>)}
          </ul>
        </div>
      </div>

      <div class="space-y-6">
        <div class="rounded-2xl p-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <h3 class="font-semibold mb-4" style="color: var(--text-primary);">{intro.alsoKnownAs.title}</h3>
          <ul class="space-y-3 text-base" style="color: var(--text-secondary);">
            {intro.alsoKnownAs.items.map((item) => (
              <li class="flex gap-3"><span style="color: var(--accent);">✦</span><span>{item}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
