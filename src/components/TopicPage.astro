---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getI18n, canonicalUrl } from '../i18n/ui';
import { TOPIC_SLUGS, TOPIC_KEY_BY_SLUG } from '../lib/topics';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const { lang, messages } = getI18n(Astro.url);
const key = TOPIC_KEY_BY_SLUG[slug];
const topic = messages.topics?.[key];

const title = topic?.title ?? messages.meta.title;
const description = topic?.description ?? messages.meta.description;
const h1 = topic?.h1 ?? title;
const intro = topic?.intro ?? '';
const sections = topic?.sections ?? [];
const faq = topic?.faq;
const relatedTitle = topic?.relatedTitle ?? messages.topicLinks?.title ?? 'More guides';

// 可见 + JSON-LD 面包屑：首页 → 本专题
const homeUrl = `/${lang}/`;
const breadcrumb = [
  { name: messages.breadcrumb?.home ?? 'Home', url: homeUrl },
  { name: h1, url: canonicalUrl(lang, slug) },
];

// FAQPage JSON-LD
const faqLd = (() => {
  if (!faq?.categories) return null;
  const mainEntity = faq.categories.flatMap((cat: any) =>
    (cat.items ?? []).map((item: any) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  );
  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity,
  };
})();

// 相关专题（其余两个 slug）
const related = TOPIC_SLUGS.filter((s) => s !== slug).map((s) => {
  const t = messages.topics?.[TOPIC_KEY_BY_SLUG[s]];
  return { slug: s, title: t?.h1 ?? t?.title ?? s, description: t?.description ?? '' };
});
---

<BaseLayout title={title} description={description} path={slug} breadcrumb={breadcrumb}>
  {faqLd && (
    <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>
  )}

  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="max-w-6xl mx-auto px-4">
      <ol class="breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={homeUrl} itemprop="item"><span itemprop="name">{messages.breadcrumb?.home ?? 'Home'}</span></a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">{h1}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <article class="section-padding" style="max-width: 56rem; margin: 0 auto; padding-left: 1rem; padding-right: 1rem;">
    <h1 class="font-display text-3xl sm:text-4xl font-semibold mb-4" style="color: var(--text-primary);">{h1}</h1>
    {intro && <p class="text-lg leading-relaxed mb-10" style="color: var(--text-secondary);">{intro}</p>}

    {sections.map((sec) => (
      <section class="mb-10">
        <h2 class="font-display text-2xl font-semibold mb-3" style="color: var(--accent);">{sec.heading}</h2>
        <p class="text-base leading-relaxed" style="color: var(--text-secondary);">{sec.body}</p>
      </section>
    ))}

    {faq && (
      <section id="faq" class="mt-14">
        <h2 class="font-display text-3xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{faq.title}</h2>
        <p class="text-center text-lg mb-10" style="color: var(--text-secondary);">{faq.subtitle}</p>
        <div class="space-y-10">
          {faq.categories.map((cat) => (
            <div>
              <h3 class="font-display text-xl font-semibold mb-4 pb-2 border-b border-white/10" style="color: var(--accent);">{cat.title}</h3>
              <div class="space-y-3">
                {cat.items.map((item) => (
                  <details class="group bg-white/5 rounded-xl border border-white/10 overflow-hidden">
                    <summary class="flex items-start justify-between gap-4 cursor-pointer list-none p-4 font-medium" style="color: var(--text-primary);">
                      <span>{item.q}</span>
                      <span class="shrink-0 text-xl transition-transform group-open:rotate-180" style="color: var(--accent);" aria-hidden="true">⌄</span>
                    </summary>
                    <p class="px-4 pb-4 text-base leading-relaxed" style="color: var(--text-secondary);">{item.a}</p>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-16 pt-10" style="border-top: 1px solid var(--border-color);">
        <h2 class="font-display text-2xl font-semibold mb-6" style="color: var(--text-primary);">{relatedTitle}</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {related.map((r) => (
            <a href={`/${lang}/${r.slug}/`} class="block bg-white/5 rounded-2xl border border-white/10 p-5 hover:opacity-90">
              <div class="font-semibold mb-1" style="color: var(--text-primary);">{r.title}</div>
              <p class="text-sm" style="color: var(--text-secondary);">{r.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
